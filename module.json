{
  "id": "deep-space",
  "name": "Deep Space Convolution",
  "abbrev": "DSPC",
  "version": "0.1.0",
  "description": "Convolution + FDN space reverb for huge depth: six synthetic stereo IRs (cathedral, cavern, tunnel, hangar, abyss, void) feeding a 16-line late reverb up to 30 s. DEPTH places the sound far away (predelay, early/late balance, air absorption, direct level), SIZE rescales the space, FREEZE holds the tail. Works in track slots and in Master FX",
  "author": "Hiro Ikezawa",
  "api_version": 2,
  "dsp": "deep-space.so",
  "component_type": "audio_fx",
  "capabilities": {
    "chainable": true,
    "component_type": "audio_fx",
    "audio_in": true,
    "audio_out": true,
    "midi_in": false,
    "midi_out": false,
    "chain_params": [
      {"key": "mix", "name": "Mix", "short_name": "MIX", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.4, "unit": "%", "display_format": "%.0f"},
      {"key": "space", "name": "Space", "short_name": "SPACE", "type": "enum", "options": ["CATHEDRAL", "CAVERN", "TUNNEL", "HANGAR", "ABYSS", "VOID"], "default": "CATHEDRAL"},
      {"key": "depth", "name": "Depth", "short_name": "DEPTH", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.6, "unit": "%", "display_format": "%.0f"},
      {"key": "size", "name": "Size", "short_name": "SIZE", "type": "float", "min": 0.5, "max": 4, "step": 0.05, "default": 1.5, "unit": "x", "display_format": "%.2f"},
      {"key": "decay", "name": "Decay", "short_name": "DECAY", "type": "float", "min": 1, "max": 30, "step": 0.1, "default": 8, "unit": "sec", "display_format": "%.1f"},
      {"key": "diffusion", "name": "Diffusion", "short_name": "DIFF", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.7, "unit": "%", "display_format": "%.0f"},
      {"key": "darkness", "name": "Darkness", "short_name": "DARK", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.4, "unit": "%", "display_format": "%.0f"},
      {"key": "freeze", "name": "Freeze", "short_name": "FRZ", "type": "enum", "options": ["OFF", "ON"], "default": "OFF"}
    ]
  }
}
